# Copie este arquivo para ".env" e preencha com suas chaves reais.
# NUNCA commite o arquivo ".env" (ele está no .gitignore) nem cole a chave no chat.
# Para refazer só o Gemini, basta preencher GEMINI_API_KEY.

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
GROQ_API_KEY=gsk_...

# Modelos. Use identificadores fixos, e não aliases como gemini-pro-latest,
# que passam a apontar para outra versão sem aviso.
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-5.6
GEMINI_MODEL=gemini-3.1-pro-preview
GROQ_MODEL=openai/gpt-oss-120b

# Configuração do Gemini. Os valores abaixo repetem os da coleta original
# (18/08 e 31/08/2026), iguais aos da tentativa 3, para que tentativas refeitas
# fiquem comparáveis às que já existem.
#
# Para usar o padrão da API (temperatura 1.0 e raciocínio dinâmico, como o Google
# recomenda para o Gemini 3), deixe TEMPERATURE e GEMINI_THINKING_BUDGET vazios
# e use GEMINI_MAX_OUTPUT_TOKENS=32000. Nesse caso, refaça as três tentativas.
#
# Só o provider do Gemini envia TEMPERATURE; os demais usam o padrão da API.
TEMPERATURE=0.2
GEMINI_THINKING_BUDGET=2048
# Alternativa ao orçamento acima (low ou high). Não defina os dois ao mesmo tempo.
GEMINI_THINKING_LEVEL=
# Teto de saída, que inclui os tokens de raciocínio.
GEMINI_MAX_OUTPUT_TOKENS=16000
