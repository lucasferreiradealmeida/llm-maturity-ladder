# Copie este arquivo para ".env" e preencha com suas chaves reais.
# NUNCA commite o arquivo ".env" (coloque no .gitignore).

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# Opcional: sobrescreve o modelo padrao de cada provedor sem editar run.js.
# Confirme o identificador exato do modelo vigente no momento do teste
# (documente essa versao no TCC - os modelos mudam com frequencia).
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-5.6
GEMINI_MODEL=gemini-3.1-pro-preview

# Temperatura usada em todas as chamadas (fixe um valor baixo para reduzir
# variancia entre execucoes e documentar reprodutibilidade no TCC).
TEMPERATURE=0.2
